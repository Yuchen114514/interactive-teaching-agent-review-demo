{
  "name": "interactive-teaching-en-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:en-demo",
    "dev:en-demo": "EN_DEMO_BUILD=1 VITE_EN_DEMO=true VITE_AGENT_API_BASE_URL=/en-demo/api/agents vite --host 127.0.0.1 --port 3010 --strictPort",
    "build": "npm run type-check && npm run build:en-demo",
    "preview": "EN_DEMO_BUILD=1 VITE_EN_DEMO=true vite preview",
    "build:en-demo": "EN_DEMO_BUILD=1 VITE_EN_DEMO=true VITE_AGENT_API_BASE_URL=/en-demo/api/agents vite build",
    "type-check": "vue-tsc --build --force",
    "test:demo": "tsx --test src/en-demo/__tests__/*.test.ts",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/sortablejs": "^1.15.8",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.5",
    "@vue-flow/minimap": "^1.5.0",
    "axios": "^1.7.7",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.7",
    "highlight.js": "^11.10.0",
    "katex": "^0.19.1",
    "localforage": "^1.10.0",
    "markdown-it": "^14.3.3",
    "markdown-it-texmath": "^1.0.0",
    "mavon-editor": "^3.0.1",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^2.2.6",
    "sortablejs": "^1.15.3",
    "three": "^0.186.1",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.11",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.86.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vue-tsc": "^3.3.14",
    "unplugin-auto-import": "^21.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10"
  },
  "overrides": {
    "minimatch@^10.2.2": "^11.0.1"
  }
}
